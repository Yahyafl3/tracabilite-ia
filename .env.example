# ===========================================
# Variables d'environnement — Traçabilité IA
# ===========================================
# Copier vers .env et renseigner les valeurs.
# Ne jamais committer .env ni de secrets réels.

# ---------- Profil Spring ----------
# local | test | prod
SPRING_PROFILES_ACTIVE=local
SPRING_FLYWAY_ENABLED=true
APP_DEMO_SEED_ENABLED=true
APP_BACKUP_DIR=./data/backups

# ---------- Docker Compose / local ----------
POSTGRES_DB=tracabilite_ia
POSTGRES_USER=tracabilite
POSTGRES_PASSWORD=change-me-local-only
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tracabilite_ia
SPRING_DATASOURCE_USERNAME=tracabilite
SPRING_DATASOURCE_PASSWORD=change-me-local-only
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ---------- Cloud DB (Neon) — Render backend ----------
# URL Neon (postgres://... ou jdbc:postgresql://...). SSL ajouté auto pour *.neon.tech
# DATABASE_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=

# ---------- Backend runtime ----------
# PORT=8080
# Production: secret >= 32 chars, jamais la valeur change-me*
JWT_SECRET=change-me-use-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
ML_SERVICE_URL=http://ml-service:5000
# Secret partagé Spring ↔ Flask (header X-Internal-Token). ≥24 chars en prod.
ML_SERVICE_TOKEN=local-dev-ml-token-not-for-prod-use
ML_CONNECT_TIMEOUT_MS=3000
ML_READ_TIMEOUT_MS=15000
# Local Docker : http://localhost — Cloud Render : https://tracabilite-ia.vercel.app
FRONTEND_URL=http://localhost
# FRONTEND_RESET_PASSWORD_URL=http://localhost/auth/reset-password

# ---------- Rate limiting ----------
APP_RATE_LIMIT_LOGIN_CAPACITY=20
APP_RATE_LIMIT_LOGIN_REFILL=10
APP_RATE_LIMIT_PASSWORD_CAPACITY=10
APP_RATE_LIMIT_PASSWORD_REFILL=5
APP_RATE_LIMIT_EXPORT_CAPACITY=30
APP_RATE_LIMIT_EXPORT_REFILL=15

# ---------- Groq (agents IA) ----------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_1=groq/compound-mini
GROQ_MODEL_2=openai/gpt-oss-120b
GROQ_MODEL_3=openai/gpt-oss-20b

# ---------- OpenRouter (historique / optionnel) ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Traçabilité-IA

# ---------- Email ----------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@mail.tracabilite-ia.online
SUPPORT_EMAIL=support@mail.tracabilite-ia.online

# ---------- Frontend (Vercel build) ----------
# API_URL=https://tracabilite-ia-backend.onrender.com

# ---------- ML service ----------
# ML_REQUIRE_CHECKSUM=true
# ML_CORS_ORIGINS=https://tracabilite-ia.vercel.app,http://localhost
# DATASETS_DIR=/datasets
# GRAFANA_ADMIN_PASSWORD=change-me-local-only
